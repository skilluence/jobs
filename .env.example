# ============================================================
# Example environment variables — copy to .env.local and fill in
# ============================================================

# Apify API token — required by app/api/search/route.js
# Used to run the "fantastic-jobs~advanced-linkedin-job-search-api" actor.
# Get yours from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here
